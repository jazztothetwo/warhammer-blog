---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection(
    "posts",
    ({ data }) => import.meta.env.DEV || !data.draft
);

posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Jarrod's Warhammer Blog">
    <header>
        <h1>Jarrod's Warhammer Blog</h1>
        <p>Painting, collecting, and working through the pile of shame.</p>
    </header>

    <section>
        <h2>Latest posts</h2>
        {
            posts.length > 0 ? (
                posts.map((post) => (
                <article>
                    {post.data.cover && (
                        <img
                            class="post-cover"
                            src={post.data.cover}
                            alt=""
                            loading="lazy"
                        />
                    )}
                    <h3>
                        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                    </h3>
                    <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-AU", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                        timeZone: "UTC",
                    })}
                    </time>
                    <p>{post.data.description}</p>
                    {post.data.draft && <p>Draft — local preview only</p>}
                </article>
                ))
            ) : (
                <p>My first hobby journal entry is coming soon.</p>
            )
        }
    </section>
</BaseLayout>

<style>
    .post-cover {
        display: block;
        width: 100%;
        max-width: 20rem;
        height: auto;
    }
</style>