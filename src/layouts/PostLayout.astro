---
import BaseLayout from "./BaseLayout.astro";

interface Props {
	title: string;
	date: Date;
	description: string;
	cover?: string;
	coverAlt?: string;
	coverWidth?: number;
	coverHeight?: number;
	tags?: string[];
}

const {
	title,
	date,
	description,
	cover,
	coverAlt,
	coverWidth,
	coverHeight,
	tags = [],
} = Astro.props;
---

<BaseLayout
	title={`${title} | Jarrod's Warhammer Blog`}
	description={description}
>
	<article class="post">
		<a href="/">← All posts</a>

		<header>
			<h1>{title}</h1>
			<time datetime={date.toISOString()}>
				{
					date.toLocaleDateString("en-AU", {
						day: "numeric",
						month: "long",
						year: "numeric",
						timeZone: "UTC",
					})
				}
			</time>
			<p>{description}</p>
			{
				tags.length > 0 && (
					<ul class="post-tags" aria-label="Post tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
		</header>
		{
			cover && (
				<img
					class="post-cover"
					src={cover}
					alt={coverAlt ?? ""}
					width={coverWidth}
					height={coverHeight}
				/>
			)
		}
		<div class="post-body">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.post {
		max-width: 70ch;
		margin-inline: auto;
		font-size: 1.125rem;
		line-height: 1.75;
	}

	header {
		margin-block: 2rem;
	}

	.post-cover {
		display: block;
		width: 100%;
		max-width: 32rem;
		height: auto;
		margin-block: 2rem;
	}

	.post-body :global(img) {
		max-width: 100%;
		height: auto;
	}

	.post h1 {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.15;
		letter-spacing: -0.025em;
	}

	.post time {
		font-size: 0.9rem;
	}

	.post-body :global(h2) {
		margin: 2rem 0 0.75rem;
		font-size: 1.6rem;
		line-height: 1.3;
	}

	.post-body :global(p),
	.post-body :global(ul),
	.post-body :global(ol) {
		margin-block: 0 1.25rem;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.post-tags li {
		padding: 0.25rem 0.65rem;
		border: 1px solid #34465e;
		border-radius: 0.25rem;
		font-size: 0.85rem;
	}
	/* Prevent long text and URLs from widening the page. */
	.post-body {
		overflow-wrap: anywhere;
	}

	/* Give tables space and their own horizontal scrolling. */
	.post-body :global(table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
		margin-block: 1.5rem;
		overflow-wrap: normal;
	}

	.post-body :global(th),
	.post-body :global(td) {
		padding: 0.6rem 0.9rem;
		border: 1px solid #34465e;
	}

	.post-body :global(th) {
		background: #1b2a3e;
	}

	/* Keep code readable, preserving its formatting. */
	.post-body :global(pre) {
		padding: 1rem;
		border-radius: 0.4rem;
		overflow-x: auto;
		overflow-wrap: normal;
	}

	.post-body :global(:not(pre) > code) {
		padding: 0.15em 0.35em;
		background: #1b2a3e;
		border-radius: 0.2rem;
	}

	/* Make quotations visually distinct. */
	.post-body :global(blockquote) {
		margin-inline: 0;
		padding-left: 1rem;
		border-left: 3px solid #9fc5ed;
	}

	/* Remove bullets beside task checkboxes. */
	.post-body :global(.task-list-item) {
		list-style: none;
	}

	/* Style keyboard shortcut labels. */
	.post-body :global(kbd) {
		padding: 0.15em 0.4em;
		border: 1px solid #53657c;
		border-radius: 0.25rem;
		background: #1b2a3e;
		font-size: 0.85em;
	}
</style>
